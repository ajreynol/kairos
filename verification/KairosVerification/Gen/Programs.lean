    s__dt_distinct_terms := fun _ _ _ => by simp only [k__dt_distinct_terms]; exact Ok.throw
    s__seq_distinct_terms := fun _ _ _ _ => by simp only [k__seq_distinct_terms]; exact Ok.throw
    }
  | n + 1 =>
    have ih := spec308 n
    {
    s__set_is_not_subset := step__set_is_not_subset ih
    s__are_distinct_terms_type := step__are_distinct_terms_type ih
    s__dt_distinct_terms := step__dt_distinct_terms ih
    s__seq_distinct_terms := step__seq_distinct_terms ih
    }

