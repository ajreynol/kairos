theorem C__are_distinct_terms_list_rec {n : Nat} (hf : S__are_distinct_terms_list_rec n) {σ : Store} {Γ : List Fact} (hI : Inv sem σ) (hΓ : Ctx σ Γ) {arg1 : Id} {A1 : Term} {arg2 : Id} {A2 : Term} {arg3 : Id} {A3 : Term}
