  exact C__eo_is_closed_rec (allS__eo_is_closed_rec kn) hI2 hΓ3 (.tail _ (.head _)) (.head _)

theorem allS__eo_is_closed : ∀ n, S__eo_is_closed n
  | 0 => fun _ _ => by simp only [k__eo_is_closed]; exact Ok.throw
  | _ + 1 => step__eo_is_closed

end Kairos.Gen
